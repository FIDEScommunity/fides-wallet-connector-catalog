{
  "name": "fides-wallet-connector-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "FIDES Community catalog of wallet connector products",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "crawl": "tsx src/crawler/index.ts",
    "validate": "ajv validate --spec=draft2020 -c ajv-formats -s schemas/wallet-connector-catalog.schema.json -d 'community-catalogs/**/wallet-connector-catalog.json'",
    "migration-report": "tsx scripts/report-wallet-migration.ts",
    "test": "tsx --test src/crawler/validation.test.ts src/crawler/tier.test.ts src/import-wp-submissions.test.ts tests/connector-form-rules.test.mjs",
    "import-wp-submissions": "tsx scripts/import-wp-submissions.ts",
    "import-wp-submissions:apply": "tsx scripts/import-wp-submissions.ts --apply",
    "test:php": "php ../fides-community-tools-tiles/tools/phpunit.phar -c tests/php/phpunit.xml.dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FIDEScommunity/fides-wallet-connector-catalog.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv-cli": "^5.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

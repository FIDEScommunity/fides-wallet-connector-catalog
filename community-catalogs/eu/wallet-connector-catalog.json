{
  "$schema": "https://fides.community/schemas/wallet-connector-catalog/v1",
  "orgId": "org:eu",
  "connectors": [
    {
      "id": "eudi-reference-issuer",
      "name": "EUDIW Reference Issuer",
      "description": "Reference web issuing service for developing and testing OpenID4VCI flows with EUDI Wallet implementations.",
      "website": "https://issuer.eudiw.dev/",
      "repository": "https://github.com/eu-digital-identity-wallet/eudi-srv-web-issuing-eudiw-py",
      "playgroundUrls": [
        "https://issuer.eudiw.dev/"
      ],
      "connectorFunctions": [
        "issuer"
      ],
      "deploymentModel": "on_premises",
      "openSource": true,
      "license": "Apache-2.0",
      "status": "development",
      "vcFormat": [
        "mdoc",
        "sd_jwt_vc"
      ],
      "issuanceProtocols": [
        "OpenID4VCI"
      ],
      "interoperabilityProfiles": [
        "EUDI Wallet ARF"
      ],
      "walletCompatibility": [
        "eudi-reference-personal-wallet",
        "national-eudi-wallet-netherlands",
        "france-identite",
        "heidi-wallet"
      ],
      "backendIntegrations": [
        "rest_api"
      ],
      "frontendIntegrations": [
        "hosted_ui_redirect"
      ],
      "serviceModels": [
        "software_only"
      ]
    },
    {
      "id": "eudi-reference-verifier",
      "name": "EUDI Reference Verifier",
      "description": "Reference verifier endpoint for developing and testing OpenID4VP and ISO 18013-5 wallet presentation flows.",
      "website": "https://verifier.eudiw.dev/home",
      "repository": "https://github.com/eu-digital-identity-wallet/eudi-srv-verifier-endpoint",
      "playgroundUrls": [
        "https://verifier.eudiw.dev/home"
      ],
      "connectorFunctions": [
        "verifier"
      ],
      "deploymentModel": "on_premises",
      "openSource": true,
      "license": "Apache-2.0",
      "status": "development",
      "vcFormat": [
        "mdoc",
        "sd_jwt_vc"
      ],
      "presentationProtocols": [
        "OpenID4VP",
        "ISO 18013-5"
      ],
      "interoperabilityProfiles": [
        "EUDI Wallet ARF"
      ],
      "walletCompatibility": [
        "eudi-reference-personal-wallet",
        "eudi-age-verification-wallet",
        "national-eudi-wallet-germany",
        "procivis-one-wallet"
      ],
      "backendIntegrations": [
        "rest_api"
      ],
      "frontendIntegrations": [
        "hosted_ui_redirect"
      ],
      "serviceModels": [
        "software_only"
      ]
    }
  ]
}
